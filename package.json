{
  "name": "feishu-codex-bridge",
  "version": "1.0.6",
  "private": true,
  "description": "Feishu to Codex desktop bridge",
  "main": "dist/desktop/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && npm run prepare:binaries && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "prepare:binaries": "node scripts/prepare-binaries.mjs",
    "package:mac": "npm run build && npm run prepare:binaries && electron-builder --mac dmg --arm64"
  },
  "devDependencies": {
    "@openai/codex": "0.158.0",
    "@types/node": "^24.0.0",
    "electron": "44.4.5",
    "electron-builder": "26.7.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "com.feishucodex.bridge",
    "productName": "飞书桥接Codex",
    "asar": true,
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      { "from": "build/bin", "to": "bin" },
      { "from": "build/licenses", "to": "licenses" },
      { "from": "icon/bar.png", "to": "bar.png" },
      { "from": "icon/main.png", "to": "main.png" }
    ],
    "directories": { "output": "release" },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [{ "target": "dmg", "arch": ["arm64"] }],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "icon": "icon/macdock.png"
    },
    "dmg": { "title": "飞书桥接Codex ${version}" }
  }
}
