{
  "name": "feishu-codex-bridge",
  "version": "1.0.23",
  "private": true,
  "description": "Feishu to Codex desktop bridge",
  "main": "dist/desktop/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && npm run prepare:binaries && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "postinstall": "patch-package",
    "prepare:binaries": "node scripts/prepare-binaries.mjs",
    "package:release": "node scripts/package-release.mjs"
  },
  "devDependencies": {
    "@openai/codex": "0.158.0",
    "@types/node": "^24.0.0",
    "crc": "3.8.0",
    "electron": "44.4.5",
    "electron-builder": "26.7.0",
    "esbuild": "0.25.12",
    "patch-package": "8.0.1",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "com.feishucodex.bridge",
    "productName": "飞书桥接Codex",
    "asar": true,
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      { "from": "build/bin", "to": "bin" },
      { "from": "build/licenses", "to": "licenses" },
      { "from": "icon/bar.png", "to": "bar.png" },
      { "from": "icon/main.png", "to": "main.png" }
    ],
    "directories": { "output": "release" },
    "mac": {
      "category": "public.app-category.productivity",
      "extendInfo": { "LSUIElement": true },
      "target": [{ "target": "dmg", "arch": ["arm64"] }],
      "artifactName": "飞书桥接Codex-${version}-mac-arm64.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "icon": "icon/macdock.png"
    },
    "dmg": { "title": "飞书桥接Codex ${version}" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "飞书桥接Codex-${version}-win-x64.${ext}",
      "icon": "icon/macdock.png",
      "extraResources": [{ "from": "icon/macdock.png", "to": "macdock.png" }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": ["zh_CN"],
      "language": "2052"
    }
  }
}
